export GOOGLE_PROJECT=$(gcloud config get-value project)
export GOOGLE_OAUTH_ACCESS_TOKEN=$(gcloud auth print-access-token)
export TF_VAR_IMPERSONATE_SERVICE_ACCOUNT_EMAIL=$(gcloud iam service-accounts list --filter='displayName="Github CICD Service Principal Read Write"' --format "value(email)")
export TF_VAR_POOL_ID=$(gcloud iam workload-identity-pools list --location="global" --format="value(displayName)")
export TF_VAR_PROVIDER_ID=$(gcloud iam workload-identity-pools providers list --location="global" --workload-identity-pool="github-identify-pool" --format="value(name)")
